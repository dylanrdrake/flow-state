{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "flow-state": ["./types/index.d.ts"]
    }
  },
  "include": ["types"],
  "exclude": ["node_modules", "dist"]
}
